{
  "name": "vtb-webcomponents",
  "private": false,
  "version": "1.0.202410250-beta",
  "description": "Visual Tour Builder - Web Components Library",
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "type": "module",
  "module": "dist/esm/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc --watch",
    "build:prod": "npm run clean && npm run format && npm run lint && npm run analyze && npm run build",
    "clean": "rm -rf dist/esm dist/cjs",
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint",
    "lint:eslint": "eslint 'src/**/*.ts'",
    "lint:lit-analyzer": "lit-analyzer",
    "format": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --ignore-path ./.eslintignore --write",
    "docs": "npm run docs:clean && npm run build && npm run analyze && npm run docs:build && npm run docs:assets && npm run docs:gen",
    "docs:clean": "rimraf docs",
    "docs:gen": "eleventy --config=.eleventy.cjs",
    "docs:gen:watch": "eleventy --config=.eleventy.cjs --watch",
    "docs:serve": "eleventy --config=.eleventy.cjs --serve",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\"",
    "test": "npm run test:dev && npm run test:prod",
    "test:dev": "wtr",
    "test:prod": "MODE=prod wtr",
    "webpack:dev": "cross-env webpack serve --hot --mode development"
  },
  "keywords": [
    "web-components",
    "lit-element",
    "typescript",
    "lit"
  ],
  "author": "Huub Segers - Bureau97",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.2",
    "ckeditor5": "^43.1.1",
    "dayjs": "^1.11.10",
    "lit": "^3.0.1",
    "lodash": "^4.17.21",
    "murmurhash": "^2.0.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@custom-elements-manifest/analyzer": "^0.10.3",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@types/google.maps": "^3.54.5",
    "@types/lodash": "^4.14.200",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "babel-plugin-lit-property-types-from-ts": "^1.1.3",
    "core-js": "^3.33.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "fast-glob": "^3.3.2",
    "globals": "^15.11.0",
    "lit-analyzer": "^2.0.1",
    "prettier": "^3.0.3",
    "ts-lit-plugin": "^2.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "overrides": {
    "minimatch": "5.1.2"
  },
  "customElements": "custom-elements.json",
  "browserslist": [
    "last 5 chrome version",
    "last 5 firefox version",
    "last 5 safari version"
  ]
}
